<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The mobile app talks to the R1 Agent over its private setup hotspot
         and the user's private home LAN. R1 may receive any DHCP address,
         so an IP-specific domain-config is not sufficient. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
